# ─────────────────────────────────────────────────────────────────────────────
# Figbolt — environment configuration
# Copy to `.env` and fill in. NOTHING here belongs in source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PGlite database (real PostgreSQL
# compiled to WASM, persisted to ./.pglite). Zero install — good for local dev.
# Set it to a Postgres connection string for staging/production. pgvector must
# be available on the server (`CREATE EXTENSION vector;`).
DATABASE_URL=
# DATABASE_URL=postgresql://user:password@localhost:5432/figbolt

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing key for session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED in production; a dev-only fallback is used when NODE_ENV!=production.
AUTH_SECRET=
# Cookie is marked `Secure` unless this is explicitly "false" (local http dev).
AUTH_COOKIE_SECURE=true

# ── AI providers ─────────────────────────────────────────────────────────────
# One of: anthropic | openai | google | local
# "local" runs the deterministic offline engine: real retrieval over your CRM,
# grounded extractive answers, no network calls, no API key. The full product
# loop (Ask AI, memory extraction, agents, approvals) works in this mode.
AI_PROVIDER=local

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro

# Embeddings: "local" uses a deterministic in-process hashing embedder so
# semantic search works offline. "openai" uses text-embedding-3-small.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=768

# ── Background jobs ──────────────────────────────────────────────────────────
# inline    — run jobs in-process against the durable DB-backed queue (default)
# inngest   — hand off to Inngest (set INNGEST_* below)
JOB_RUNNER=inline
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Integrations (OAuth) ─────────────────────────────────────────────────────
# Every connector has a real provider interface plus a demo adapter. With no
# credentials the connector runs in demo mode and syncs realistic fixture data.
INTEGRATION_MODE=demo
# 32-byte base64url key used to encrypt stored OAuth tokens at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTEGRATION_TOKEN_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ── Outbound email ───────────────────────────────────────────────────────────
# console | resend | ses  — "console" writes to the outbox and logs, sends nothing.
EMAIL_PROVIDER=console
EMAIL_FROM="Figbolt <hello@figbolt.com>"
RESEND_API_KEY=

# ── Object storage (S3-compatible) ───────────────────────────────────────────
# "local" stores uploads under ./.storage with short-lived signed URLs.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Observability ────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Jev: the model router ────────────────────────────────────────────────────
# Jev is a decision model (typesafe/jev-1.13) that never writes text. It sizes
# each AI job in ~0.3s for a fraction of a cent, and the job goes to the
# smallest model that can do it well. Input $0.042/1M tokens, output free.
#
# OFF by default. Turning it on sends a *description* of each job — its kind,
# its size, its shape — to api.typesafe.ai. Customer email and transcript
# content is never sent unless you opt in below. Key: typesafe.ai dashboard.
JEV_ROUTER=off
TYPESAFE_API_KEY=
# Also send your own request text (never retrieved customer content):
JEV_SEND_CONTENT=false
#
# Which provider serves each tier, smallest to largest. Leave blank to skip a
# tier; with fewer than two configured the router stays out of the way.
MODEL_TIER_TINY=
MODEL_TIER_EVERYDAY=
MODEL_TIER_LARGE=
MODEL_TIER_HARDEST=
